CREATE TABLE deck (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    parent_id TEXT REFERENCES deck(id),
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_archived INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX deck_parent_name ON deck(parent_id, name);

selectById:
SELECT id, name, parent_id, created_at, updated_at, is_archived
FROM deck
WHERE id = :id;

selectAll:
SELECT id, name, parent_id, created_at, updated_at, is_archived
FROM deck
WHERE :includeArchived = 1 OR is_archived = 0
ORDER BY name COLLATE NOCASE;

upsert:
INSERT OR REPLACE INTO deck(id, name, parent_id, created_at, updated_at, is_archived)
VALUES (:id, :name, :parentId, :createdAt, :updatedAt, :isArchived)
;

deleteById:
DELETE FROM deck
WHERE id = :id;
